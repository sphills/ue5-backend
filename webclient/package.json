{
  "name": "webclient",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-friendly stash manager. Renders Pug pages and does everything through the Game API.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
