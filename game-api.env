NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# Hops allowed to set X-Forwarded-For. Must include the WebClient's address so per-player
# rate limits see the player's IP rather than the WebClient's. Examples: loopback, 10.0.0.5, 1
TRUST_PROXY=loopback

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=SMlHSDperzBXBQy30PQ8Zk6Xb
DB_NAME=ue5_test_db
DB_POOL_SIZE=10

# Comma-separated shared secrets for UE5 dedicated servers (X-Server-Key header).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GAME_SERVER_KEYS=
